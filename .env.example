# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Never commit real values. Never add a key here that isn't prefixed VITE_
# to any frontend code — VITE_ vars are bundled into the browser and public.
# ---------------------------------------------------------------------------

# --- Supabase: browser (safe to expose, publishable by design) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase: server-side rendering (same values as the VITE_ ones) -------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase: sync script only. SECRET. Bypasses all row-level security. --
# Dashboard > Project Settings > API keys > service_role. Never in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Klaviyo (account XuTPpc). SECRET. -------------------------------------
# Klaviyo > Settings > Account > API keys > Create Private API Key.
# Needs read scope on: Campaigns, Flows, Metrics, Profiles.
KLAVIYO_API_KEY=

# --- LoyaltyLion (site 48519, read-only). SECRET. --------------------------
# LoyaltyLion admin > Settings > Integrations > API keys.
LOYALTYLION_TOKEN=
LOYALTYLION_SECRET=

# --- Shopify Admin API. SECRET. -------------------------------------------
# Shopify admin > Settings > Apps and sales channels > Develop apps >
# create an app > Admin API access token. Needs read_orders, read_reports.
SHOPIFY_STORE_DOMAIN=drynksapp.myshopify.com
SHOPIFY_ADMIN_TOKEN=
