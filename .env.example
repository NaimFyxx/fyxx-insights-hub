# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Never commit real values. Never add a key here that isn't prefixed VITE_
# to any frontend code — VITE_ vars are bundled into the browser and public.
# ---------------------------------------------------------------------------

# --- Supabase: browser (safe to expose, publishable by design) -------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase: server-side rendering (same values as the VITE_ ones) -------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase: sync script only. SECRET. Bypasses all row-level security. --
# Dashboard > Project Settings > API keys > service_role. Never in frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Klaviyo (account XuTPpc). SECRET. -------------------------------------
# Klaviyo > Settings > Account > API keys > Create Private API Key.
# Needs read scope on: Campaigns, Flows, Metrics, Profiles.
KLAVIYO_API_KEY=

# --- LoyaltyLion (site 48519, read-only). SECRET. --------------------------
# CURRENT METHOD: LoyaltyLion admin > Manage > API keys. Creates a `pat_...`
# key passed as a Bearer token. This is the one to create.
LOYALTYLION_API_KEY=
# DEPRECATED fallback: the older token + secret pair (HTTP Basic). Only fill
# these if your account predates API keys. Leave blank if you set the key above.
LOYALTYLION_TOKEN=
LOYALTYLION_SECRET=

# --- Shopify Admin API. SECRET. -------------------------------------------
SHOPIFY_STORE_DOMAIN=drynksapp.myshopify.com

# CURRENT METHOD. Shopify removed admin-created custom apps on 1 Jan 2026, so
# new apps no longer issue a permanent shpat_ token. Copy these two from the
# Dev Dashboard (https://dev.shopify.com/dashboard) > "Fyxx Insights Hub" >
# API credentials. The script exchanges them for a 24-hour access token at the
# start of each run and refreshes it automatically if a long backfill outlives
# it. Scopes must include read_orders AND read_all_orders — without
# read_all_orders the API silently returns nothing older than 60 days, so
# backfills come back empty rather than erroring.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# DEPRECATED fallback: a permanent shpat_ token from an admin-created custom
# app. Only apps made before 1 Jan 2026 have one. Leave blank; if it is set it
# takes precedence and no token exchange happens.
SHOPIFY_ADMIN_TOKEN=
